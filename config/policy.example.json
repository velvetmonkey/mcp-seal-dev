{
  "approval": {
    "control_file": "/tmp/seal-approvals.ndjson",
    "ttl_seconds": 120
  },
  "tools": [
    {
      "name": "db.execute",
      "mode": "guarded",
      "match": {
        "type": "contains_any_ci",
        "arg": "sql",
        "needles": ["drop", "delete", "truncate"]
      },
      "target": [
        { "full_arguments": true }
      ]
    },
    {
      "name": "payments.send",
      "mode": "guarded",
      "match": { "type": "always" },
      "target": [
        { "full_arguments": true }
      ]
    },
    {
      "name": "shell.run",
      "mode": "deny",
      "match": { "type": "always" },
      "target": []
    }
  ]
}
